<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base gradient: indigo → violet → pink -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="#4F46E5"
                android:centerColor="#8B5CF6"
                android:endColor="#EC4899" />
        </shape>
    </item>
    <!-- Top sheen for depth -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#26FFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
    <!-- Bottom darken to ground the icon -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="90"
                android:startColor="#002A1F5F"
                android:endColor="#332A1F5F" />
        </shape>
    </item>
</layer-list>